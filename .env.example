# note-bridge 支援 GitHub 與 GitLab（gitlab.com）。兩邊都是選配：
# 只設 GitHub 就只有 GitHub 能登入，只設 GitLab 就只有 GitLab，兩個都設就都能用。
# 公開 repo 不需任何設定即可瀏覽。

# 對外網址（OAuth redirect 與分享連結都用它）
BASE_URL=http://localhost:3210

# ── GitHub OAuth App（https://github.com/settings/developers → New OAuth App）──
# Authorization callback URL: <BASE_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 匿名訪客讀 public repo 的後備 token（提高 rate limit 用，可留空）
GITHUB_FALLBACK_TOKEN=

# ── GitLab OAuth App（https://gitlab.com/-/profile/applications）──
# Redirect URI: <BASE_URL>/api/auth/callback ；Scopes 勾 api
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# 匿名訪客讀 public 專案的後備 token（可留空）
GITLAB_FALLBACK_TOKEN=

# session token 加密金鑰（未設定會自動產生並存在 data/.secret）
SECRET=

# ── 首頁預設落地（選配）──
# 設了就把「/」直接導到這個 repo 的 DEFAULT_FILE；留空維持原本首頁。
# 格式：<provider>/<URL-encode 過的 projectPath>（GitLab 巢狀群組的 / 要寫成 %2F）
DEFAULT_REPO=gitlab/interagent-io%2Finteragent-bible
DEFAULT_FILE=README.md

PORT=3210
