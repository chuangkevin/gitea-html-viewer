# note-bridge 支援 GitHub、GitLab（gitlab.com）與自架 Gitea。三邊都是選配：
# 只設一個 provider 就只有它能登入，多設就都能用。
# 公開 repo 不需任何設定即可瀏覽。

# 對外網址（OAuth redirect 與分享連結都用它）
BASE_URL=http://localhost:3210

# ── GitHub OAuth App（https://github.com/settings/developers → New OAuth App）──
# Authorization callback URL: <BASE_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 匿名訪客讀 public repo 的後備 token（提高 rate limit 用，可留空）
GITHUB_FALLBACK_TOKEN=

# ── GitLab OAuth App（https://gitlab.com/-/profile/applications）──
# Redirect URI: <BASE_URL>/api/auth/callback ；Scopes 勾 api
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# 匿名訪客讀 public 專案的後備 token（可留空）
GITLAB_FALLBACK_TOKEN=

# ── 自架 Gitea（例：https://gitea.ia）──
# OAuth 走 Gitea：Settings → Applications → Manage OAuth2 Applications
# Redirect URI: <BASE_URL>/api/auth/callback ；Scope 勾 read:user 與 write:repository
GITEA_URL=https://gitea.ia
# docker-host 上的 Gitea 位址與公司 root CA；通常沿用預設值即可。
GITEA_HOST_IP=10.11.12.55
INTERNAL_CA_PATH=/home/interagent/ca-web/rootCA.pem
GITEA_CLIENT_ID=
GITEA_CLIENT_SECRET=
# 匿名訪客讀 public repo 的後備 token（可留空）
GITEA_FALLBACK_TOKEN=

# session token 加密金鑰（未設定會自動產生並存在 data/.secret）
SECRET=

# ── 團隊模式：多 token、一人一組（選配）──
# 每位成員一組自己的 GitLab token，commit 會記在該成員名下。
# 優先讀 DATA_DIR/identities.json（推薦，改完不用重啟）；沒有才讀這個變數。
# ⚠️ 選名字不是身分驗證，內網任何人都能冒名；要真驗證請走個人 OAuth 登入。
# NOTE_IDENTITIES=[{"name":"王小明","email":"ming@example.com","token":"glpat-..."}]

# ── 首頁預設落地（選配）──
# 設了就把「/」直接導到這個 repo 的 DEFAULT_FILE；留空維持原本首頁。
# 格式：<provider>/<URL-encode 過的 projectPath>（GitLab 巢狀群組的 / 要寫成 %2F）
DEFAULT_REPO=gitlab/interagent-io%2Fglobal-doc
DEFAULT_FILE=README.md

# ── repo 存取模式與 Admin 白名單（選配）──
# 免登入「公開可編」與「admin 能編」白名單 repo 寫入權限使用的共用 Token：
#   GitLab：Personal Access Token，scope 勾 api（note 走 REST API v4 寫檔，write_repository 不夠），且該帳號需對目標 repo 有 Developer 以上權限
#   GitHub：Personal Access Token，需 repo 寫入權限
GITHUB_OPEN_TOKEN=
GITLAB_OPEN_TOKEN=
# Gitea：access token，scope 勾 write:repository（寫入需要）
GITEA_OPEN_TOKEN=

# 免登入公開可編模式 commit 的預設作者資訊
NOTE_OPEN_AUTHOR_NAME=
NOTE_OPEN_AUTHOR_EMAIL=

# Admin 控制台登入密碼（未設定則禁用 Admin 管理功能）。這是進 /admin 管理頁的密碼，請用足夠長度的隨機字串。
ADMIN_KEY=
# OAuth 登入自動具備 Admin 權限的使用者名單（逗號分隔 login 名稱）
ADMIN_LOGINS=

PORT=3210

# ── 互動 HTML 頁寫入佇列（選配，有預設值）──
# note.ia 內嵌的 HTML 互動頁（POC 看板、CRM）按下按鈕時，寫入不直接 commit，
# 先排進佇列立刻回覆，由背景 worker 合併後一次 commit。
# 安靜視窗：最後一次寫入後多久沒有新寫入就落地（毫秒）
NOTE_QUEUE_QUIET_MS=1500
# 封頂：一直有人操作時最多等這麼久一定落地一次（毫秒）
NOTE_QUEUE_CAP_MS=5000
# 落地失敗的退避重試次數上限
NOTE_QUEUE_MAX_ATTEMPTS=5
# 設 1 可關閉背景 worker（寫入仍會排入，只是不會自動落地）
# NOTE_QUEUE_DISABLED=
